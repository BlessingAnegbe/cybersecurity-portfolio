-773e3671a845" aria-label="View related links" class="vDOt8c" jsaction="click:&amp;BZSmYd_2f|S9kKve;mouseenter:&amp;BZSmYd_2f|sbHm2b;mouseleave:&amp;BZSmYd_2f|Tx5Rb" data-ved="2ahUKEwiNh9a9mY-WAxXbTaQEHZVNDgYQye0OeggIAggBCAYQAQ" data-hveid="CAIIAQgGEAE"><span class="pxxQye T6UJT"><div class="a14YJe" jsaction="" jscontroller="sRLmTc#WhfBh" data-sfc-root="c" jsuid="BZSmYd_2j"><svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" height="12px" viewBox="0 -960 960 960" width="12px"><path d="M440-280H280q-83 0-141.5-58.5T80-480q0-83 58.5-141.5T280-680h160v80H280q-50 0-85 35t-35 85q0 50 35 85t85 35h160v80ZM320-440v-80h320v80H320Zm200 160v-80h160q50 0 85-35t35-85q0-50-35-85t-85-35H520v-80h160q83 0 141.5 58.5T880-480q0 83-58.5 141.5T680-280H520Z"></path></svg><!--TgQPHd|||[]--></div></span><div jsuid="BZSmYd_2g" style="display: none;" data-ved="2ahUKEwiNh9a9mY-WAxXbTaQEHZVNDgYQlZkReggIAggBCAYQAg"></div></button></span><!--TgQPHd|||[[&quot;c63bbd95-3a07-42a0-a51c-773e3671a845&quot;,null,null,0,&quot;&quot;,&quot;&quot;,0,null,null,null,null,0,null,0]]--></span><!--TgQPHd|||[]--></div><ul class="KsbFXc U6u95" jsaction="" jscontroller="mPWODf#NS0kde" data-sfc-root="ep" jsuid="BZSmYd_2k" data-ved="2ahUKEwiNh9a9mY-WAxXbTaQEHZVNDgYQ-7AUeggIAggBCAcQAA" data-hveid="CAIIAQgHEAA" data-processed="true"><li class="Z1qcYe" data-sfc-cp="" jsaction="" jscontroller="oSLmPe#HokZ0d" data-sfc-root="ep" jsuid="BZSmYd_2l" data-hveid="CAIIAQgHEAE" data-processed="true"><div class="Jd31eb" jsaction="" jscontroller="r3gopb#L9Jtpd" data-sfc-root="ep" jsuid="BZSmYd_2m" data-processed="true"><div class="JWCOje" data-processed="true"></div><!--TgQPHd|||[]--></div><!--TgQPHd|||[]--></li><li class="Z1qcYe" data-sfc-cp="" jsaction="" jscontroller="oSLmPe#HokZ0d" data-sfc-root="ep" jsuid="BZSmYd_2n" data-hveid="CAIIAQgHEAI" data-processed="true" data-sae="" style=""><span class="iNqyIf" data-sfc-cp="" jsaction="" jscontroller="KdQfFc#d5Qebf" data-sfc-root="ep" jsuid="BZSmYd_2o"><strong class="rQesXe MPyX" data-sfc-cp="" jsaction="" jscontroller="tP2kf#s32ZS" data-sfc-root="ep" jsuid="BZSmYd_2p">Hex Code<!--TgQPHd|||[]--></strong>: <code dir="ltr" class="KDcb0c" jsaction="" jscontroller="hNviFe#redMub" data-sfc-root="ep" jsuid="BZSmYd_2q" data-sae="" style="">#7A37D9<!--TgQPHd|||[]--></code> or <code dir="ltr" class="KDcb0c" jsaction="" jscontroller="hNviFe#redMub" data-sfc-root="ep" jsuid="BZSmYd_2r" data-sae="" style="">#8A2BE2<!--TgQPHd|||[]--></code> (Blue Violet)<!--TgQPHd|||[]--></span><div class="Jd31eb" jsaction="" jscontroller="r3gopb#L9Jtpd" data-sfc-root="ep" jsuid="BZSmYd_2s"><div class="JWCOje"></div><!--TgQPHd|||[]--></div><!--TgQPHd|||[]--></li><li class="Z1qcYe" data-sfc-cp="" jsaction="" jscontroller="oSLmPe#HokZ0d" data-sfc-root="ep" jsuid="BZSmYd_2t" data-hveid="CAIIAQgHEAM" data-processed="true" data-sae="" style=""><span class="iNqyIf" data-sfc-cp="" jsaction="" jscontroller="KdQfFc#d5Qebf" data-sfc-root="ep" jsuid="BZSmYd_2u"><strong class="rQesXe MPyX" data-sfc-cp="" jsaction="" jscontroller="tP2kf#s32ZS" data-sfc-root="ep" jsuid="BZSmYd_2v">RGB Values<!--TgQPHd|||[]--></strong>: Approximately <strong class="rQesXe MPyX" data-sfc-cp="" jsaction="" jscontroller="tP2kf#s32ZS" data-sfc-root="ep" jsuid="BZSmYd_2w">122, 55, 217<!--TgQPHd|||[]--></strong><!--TgQPHd|||[]--></span><div class="Jd31eb" jsaction="" jscontroller="r3gopb#L9Jtpd" data-sfc-root="ep" jsuid="BZSmYd_2x"><div class="JWCOje"></div><!--TgQPHd|||[]--></div><!--TgQPHd|||[]--></li><li class="Z1qcYe" data-sfc-cp="" jsaction="" jscontroller="oSLmPe#HokZ0d" data-sfc-root="ep" jsuid="BZSmYd_2y" data-hveid="CAIIAQgHEAQ" data-processed="true" data-sae="" style=""><span class="iNqyIf" data-sfc-cp="" jsaction="" jscontroller="KdQfFc#d5Qebf" data-sfc-root="ep" jsuid="BZSmYd_2z"><strong class="rQesXe MPyX" data-sfc-cp="" jsaction="" jscontroller="tP2kf#s32ZS" data-sfc-root="ep" jsuid="BZSmYd_30">CMYK Color Profile<!--TgQPHd|||[]--></strong>: Roughly <strong class="rQesXe MPyX" data-sfc-cp="" jsaction="" jscontroller="tP2kf#s32ZS" data-sfc-root="ep" jsuid="BZSmYd_31">44% Cyan, 75% Magenta, 0% Yellow, 15% Black<!--TgQPHd|||[]--></strong><!--TgQPHd|||[]--></span><span jsuid="BZSmYd_32" class="DHPVt Wg1cdb notranslate" jsaction="rcuQ6b:&amp;BZSmYd_32|npT2md" jscontroller="XqmSxe#JjQTXe" data-sfc-root="ep" data-wiz-uids="BZSmYd_33,BZSmYd_34,BZSmYd_35" data-sfc-inited="2"><span class="NMq1me" data-animation-atomic="" jsaction="click:&amp;BZSmYd_32|QNgZi" data-sae="" style=""><span aria-hidden="true">&nbsp;</span><!--qkimaf BZSmYd_32/HugV6--><!--cqw1tb BZSmYd_32/HugV6--><button jsuid="BZSmYd_34" tabindex="0" data-amic="true" data-icl-uuid="21933bdd-710c-4244-8e56-ea6614886b16" aria-label="View related links" class="vDOt8c" jsaction="click:&amp;BZSmYd_32|S9kKve;mouseenter:&amp;BZSmYd_32|sbHm2b;mouseleave:&amp;BZSmYd_32|Tx5Rb" data-ved="2ahUKEwiNh9a9mY-WAxXbTaQEHZVNDgYQye0OeggIAggBCAcQBQ" data-hveid="CAIIAQgHEAU"><span class="pxxQye T6UJT"><div class="a14YJe" jsaction="" jscontroller="sRLmTc#WhfBh" data-sfc-root="c" jsuid="BZSmYd_36"><svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" height="12px" viewBox="0 -960 960 960" width="12px"><path d="M440-280H280q-83 0-141.5-58.5T80-480q0-83 58.5-141.5T280-680h160v80H280q-50 0-85 35t-35 85q0 50 35 85t85 35h160v80ZM320-440v-80h320v80H320Zm200 160v-80h160q50 0 85-35t35-85q0-50-35-85t-85-35H520v-80h160q83 0 141.5 58.5T880-480q0 83-58.5 141.5T680-280H520Z"></path></svg><!--TgQPHd|||[]--></div></span><div jsuid="BZSmYd_33" style="display: none;" data-ved="2ahUKEwiNh9a9mY-WAxXbTaQEHZVNDgYQlZkReggIAggBCAcQBg"></div></button></span><!--TgQPHd|||[[&quot;21933bdd-710c-4244-8e56-ea6614886b16&quot;,null,null,0,&quot;&quot;,&quot;&quot;,0,null,null,null,null,0,null,0]]--></span><div class="Jd31eb" jsaction="" jscontroller="r3gopb#L9Jtpd" data-sfc-root="ep" jsuid="BZSmYd_37"><div class="JWCOje"></div><!--TgQPHd|||[]--></div><!--TgQPHd|||[]--></li><li class="Z1qcYe" data-sfc-cp="" jsaction="" jscontroller="oSLmPe#HokZ0d" data-sfc-root="ep" jsuid="BZSmYd_38" data-hveid="CAIIAQgHEAc" data-processed="true"><div class="Jd31eb" jsaction="" jscontroller="r3gopb#L9Jtpd" data-sfc-root="ep" jsuid="BZSmYd_39" data-processed="true"><div class="JWCOje" data-processed="true"></div><!--TgQPHd|||[]--></div><!--TgQPHd|||[]--></li><!--TgQPHd|||[]--></ul><div class="Fsg96" data-sfc-cp="" jsaction="rcuQ6b:&amp;BZSmYd_3a|npT2md" jscontroller="KHhJQ#U8DOt" data-sfc-root="ep" jsuid="BZSmYd_3a" data-processed="true" data-sfc-inited="2"><!--TgQPHd|||[]--></div><div class="otQkpb" aria-level="3" role="heading" data-animation-nesting="" data-sfc-cp="" jsaction="" jscontroller="a7qCn#ZxCkTb" data-sfc-root="ep" jsuid="BZSmYd_3b" data-processed="true" data-sae="" style="">Visual Characteristics<!--TgQPHd|||[]--></div><ul class="KsbFXc U6u95" jsaction="" jscontroller="mPWODf#NS0kde" data-sfc-root="ep" jsuid="BZSmYd_3c" data-ved="2ahUKEwiNh9a9mY-WAxXbTaQEHZVNDgYQ-7AUeggIAggBCAgQAA" data-hveid="CAIIAQgIEAA" data-processed="true"><li class="Z1qcYe" data-sfc-cp="" jsaction="" jscontroller="oSLmPe#HokZ0d" data-sfc-root="ep" jsuid="BZSmYd_3d" data-hveid="CAIIAQgIEAE" data-processed="true"><div class="Jd31eb" jsaction="" jscontroller="r3gopb#L9Jtpd" data-sfc-root="ep" jsuid="BZSmYd_3e" data-processed="true"><div class="JWCOje" data-processed="true"></div><!--TgQPHd|||[]--></div><!--TgQPHd|||[]--></li><li class="Z1qcYe" data-sfc-cp="" jsaction="" jscontroller="oSLmPe#HokZ0d" data-sfc-root="ep" jsuid="BZSmYd_3f" data-hveid="CAIIAQgIEAI" data-sae="" style=""><span class="iNqyIf" data-sfc-cp="" jsaction="" jscontroller="KdQfFc#d5Qebf" data-sfc-root="ep" jsuid="BZSmYd_3g"><strong class="rQesXe MPyX" data-sfc-cp="" jsaction="" jscontroller="tP2kf#s32ZS" data-sfc-root="ep" jsuid="BZSmYd_3h">Undertone<!--TgQPHd|||[]--></strong>: Strongly leaning toward a <strong class="rQesXe MPyX" data-sfc-cp="" jsaction="" jscontroller="tP2kf#s32ZS" data-sfc-root="ep" jsuid="BZSmYd_3i">blue-dominant base<!--TgQPHd|||[]--></strong>, giving it a cool, electric quality rather than a warm, reddish plum or maroon tint.<!--TgQPHd|||[]--></span><div class="Jd31eb" jsaction="" jscontroller="r3gopb#L9Jtpd" data-sfc-root="ep" jsuid="BZSmYd_3j"><div class="JWCOje"></div><!--TgQPHd|||[]--></div><!--TgQPHd|||[]--></li><li class="Z1qcYe" data-sfc-cp="" jsaction="" jscontroller="oSLmPe#HokZ0d" data-sfc-root="ep" jsuid="BZSmYd_3k" data-hveid="CAIIAQgIEAM" data-sae="" style=""><span class="iNqyIf" data-sfc-cp="" jsaction="" jscontroller="KdQfFc#d5Qebf" data-sfc-root="ep" jsuid="BZSmYd_3l"><strong class="rQesXe MPyX" data-sfc-cp="" jsaction="" jscontroller="tP2kf#s32ZS" data-sfc-root="ep" jsuid="BZSmYd_3m">Brightness<!--TgQPHd|||[]--></strong>: Highly vibrant with a solid, matte mid-tone saturation that provides high-contrast visibility against the dark background.<!--TgQPHd|||[]--></span><span jsuid="BZSmYd_3n" class="DHPVt Wg1cdb notranslate" jsaction="rcuQ6b:&amp;BZSmYd_3n|npT2md" jscontroller="XqmSxe#JjQTXe" data-sfc-root="ep" data-wiz-uids="BZSmYd_3o,BZSmYd_3p,BZSmYd_3q" data-sfc-inited="2"><span class="NMq1me" data-animation-atomic="" jsaction="click:&amp;BZSmYd_3n|QNgZi" data-sae="" style=""><span aria-hidden="true">&nbsp;</span><!--qkimaf BZSmYd_3n/HugV6--><!--cqw1tb BZSmYd_3n/HugV6--><button jsuid="BZSmYd_3p" tabindex="0" data-amic="true" data-icl-uuid="de221a78-016e-4f13-a462-bbaa114b26d4" aria-label="View related links" class="vDOt8c" jsaction="click:&amp;BZSmYd_3n|S9kKve;mouseenter:&amp;BZSmYd_3n|sbHm2b;mouseleave:&amp;BZSmYd_3n|Tx5Rb" data-ved="2ahUKEwiNh9a9mY-WAxXbTaQEHZVNDgYQye0OeggIAggBCAgQBA" data-hveid="CAIIAQgIEAQ"><span class="pxxQye T6UJT"><div class="a14YJe" jsaction="" jscontroller="sRLmTc#WhfBh" data-sfc-root="c" jsuid="BZSmYd_3r"><svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" height="12px" viewBox="0 -960 960 960" width="12px"><path d="M440-280H280q-83 0-141.5-58.5T80-480q0-83 58.5-141.5T280-680h160v80H280q-50 0-85 35t-35 85q0 50 35 85t85 35h160v80ZM320-440v-80h320v80H320Zm200 160v